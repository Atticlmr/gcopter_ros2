<?xml version="1.0"?>
<package format="3">
  <name>gcopter_ros2</name>
  <version>0.1.0</version>
  <description>Independent ROS 2 adapter of the GCOPTER global planning demo.</description>

  <maintainer email="li@example.com">li</maintainer>
  <license>BSD</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>visualization_msgs</depend>

  <exec_depend>mockamap</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>rqt_plot</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
